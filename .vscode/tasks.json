        {
            "label": "copy-release-binaries",
            "type": "shell",
            "command": "echo unsupported platform",
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "$branch = (git -C '${workspaceFolder}' branch --show-current).Trim().Replace('/','-'); if ($branch -eq 'master') { $name = 'yak.exe' } else { $name = 'yak-' + $branch + '.exe' }; New-Item -ItemType Directory -Force -Path '${env:USERPROFILE}/bin'; Copy-Item '${workspaceFolder}/target/release/yak.exe' ('${env:USERPROFILE}/bin/' + $name) -Force; Copy-Item '${workspaceFolder}/target/release/yak_c.dll' '${env:USERPROFILE}/bin/yak_c.dll' -Force; Write-Host ('Release binary copied to ~/bin/' + $name)"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "branch=$(git -C '${workspaceFolder}' branch --show-current | tr '/' '-') && if [ \"$branch\" = \"master\" ]; then name=yak; else name=yak-$branch; fi && mkdir -p ~/.local/bin && cp '${workspaceFolder}/target/release/yak' ~/.local/bin/$name && cp '${workspaceFolder}/target/release/libyak_c.dylib' ~/.local/bin/libyak_c.dylib && echo \"Release binary copied to ~/.local/bin/$name\""
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "branch=$(git -C '${workspaceFolder}' branch --show-current | tr '/' '-') && if [ \"$branch\" = \"master\" ]; then name=yak; else name=yak-$branch; fi && mkdir -p ~/.local/bin && cp '${workspaceFolder}/target/release/yak' ~/.local/bin/$name && cp '${workspaceFolder}/target/release/libyak_c.so' ~/.local/bin/libyak_c.so && echo \"Release binary copied to ~/.local/bin/$name\""
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "cargo-build-all-release"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
